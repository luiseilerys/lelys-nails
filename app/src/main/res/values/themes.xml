<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema simple y estable (sin shapeAppearance personalizado que crasheaba al inicio) -->
    <style name="Theme.LelysNails" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/rose</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/rose_light</item>
        <item name="colorOnSecondary">@color/ink</item>
        <item name="android:statusBarColor">@color/rose_dark</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="bottomSheetDialogTheme">@style/Theme.LelysNails.BottomSheet</item>
    </style>

    <style name="Theme.LelysNails.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Material3.BottomSheet</item>
        <item name="android:background">@color/white</item>
    </style>
</resources>
