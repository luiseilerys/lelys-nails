<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LelysNails" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/rose</item>
        <item name="colorPrimaryDark">@color/rose_dark</item>
        <item name="colorAccent">@color/rose</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">@color/rose_dark</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="bottomSheetDialogTheme">@style/Theme.LelysNails.BottomSheet</item>
    </style>

    <style name="Theme.LelysNails.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.LelysNails.BottomSheet</item>
    </style>

    <style name="Widget.LelysNails.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="shapeAppearance">@style/Shape.LelysNails.BottomSheet</item>
        <item name="backgroundTint">@color/white</item>
    </style>

    <style name="Shape.LelysNails.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>
