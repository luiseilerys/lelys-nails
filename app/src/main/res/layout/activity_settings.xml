<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootSettings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/headerSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="40dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:src="@drawable/ic_chevron_left" />

        <TextView
            android:id="@+id/tvSettingsTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Ajustes"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/lblSalon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre del salon"
                android:textAllCaps="true"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etSalonName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="18dp"
                android:hint="Lely's Nails"
                android:inputType="textCapWords"
                android:maxLines="1"
                android:padding="14dp" />

            <TextView
                android:id="@+id/lblStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Estilo visual"
                android:textAllCaps="true"
                android:textSize="11sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="18dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/lblNight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Modo claro / oscuro"
                android:textAllCaps="true"
                android:textSize="11sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgNight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="18dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/lblWeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="La semana comienza en"
                android:textAllCaps="true"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spWeekStart"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="18dp" />

            <TextView
                android:id="@+id/lblSlots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Turnos maximos por dia"
                android:textAllCaps="true"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spMaxSlots"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="18dp" />

            <TextView
                android:id="@+id/lblOffDays"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dias no laborables fijos"
                android:textAllCaps="true"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/offDaysContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="18dp"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveSettings"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Guardar ajustes"
                android:textStyle="bold"
                app:cornerRadius="16dp" />

            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="Lely's Nails v1.1"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
