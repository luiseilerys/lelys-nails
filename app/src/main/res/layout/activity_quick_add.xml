<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDF6F9"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvQuickDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#E8799A"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Nombre de la clienta"
        android:textColor="#A89099"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etQuickName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:hint="Ej. Maria Lopez"
        android:inputType="textPersonName|textCapWords"
        android:maxLines="1"
        android:padding="14dp"
        android:textColor="#3D2B33" />

    <Button
        android:id="@+id/btnQuickSave"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_widget_btn"
        android:text="Guardar turno"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnQuickCancel"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@android:color/transparent"
        android:text="Cancelar"
        android:textAllCaps="false"
        android:textColor="#A89099" />
</LinearLayout>
