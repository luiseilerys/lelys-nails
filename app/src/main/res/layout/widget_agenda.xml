<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Header mes -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widgetBtnPrev"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:contentDescription="Mes anterior"
            android:src="@drawable/ic_chevron_left"
            android:tint="#E8799A" />

        <TextView
            android:id="@+id/widgetMonthLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="#3D2B33"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/widgetBtnNext"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:contentDescription="Mes siguiente"
            android:src="@drawable/ic_chevron_right"
            android:tint="#E8799A" />

        <ImageButton
            android:id="@+id/widgetBtnRefresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@android:color/transparent"
            android:contentDescription="Actualizar"
            android:src="@drawable/ic_calendar"
            android:tint="#A89099" />
    </LinearLayout>

    <!-- Dias de la semana -->
    <LinearLayout
        android:id="@+id/widgetWeekdays"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView style="@style/WidgetWeekday" android:text="L" />
        <TextView style="@style/WidgetWeekday" android:text="M" />
        <TextView style="@style/WidgetWeekday" android:text="X" />
        <TextView style="@style/WidgetWeekday" android:text="J" />
        <TextView style="@style/WidgetWeekday" android:text="V" />
        <TextView style="@style/WidgetWeekday" android:text="S" />
        <TextView style="@style/WidgetWeekday" android:text="D" />
    </LinearLayout>

    <!-- Grilla de dias -->
    <GridView
        android:id="@+id/widgetGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:layout_weight="1"
        android:horizontalSpacing="2dp"
        android:numColumns="7"
        android:stretchMode="columnWidth"
        android:verticalSpacing="2dp" />

    <!-- Panel del dia seleccionado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_widget_panel"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/widgetSelectedDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#E8799A"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widgetAppointments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="4"
            android:textColor="#3D2B33"
            android:textSize="12sp" />

        <Button
            android:id="@+id/widgetBtnQuickAdd"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_widget_btn"
            android:text="+ Agregar turno (nombre)"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
